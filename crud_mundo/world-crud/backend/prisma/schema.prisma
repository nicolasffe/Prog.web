generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Continent {
  id          String    @id @default(cuid())
  name        String
  code        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  countries   Country[]
}

model Country {
  id           String    @id @default(cuid())
  name         String
  officialName String?
  code         String    @unique
  capital      String?
  region       String?
  subregion    String?
  population   Int?
  area         Float?
  latitude     Float?
  longitude    Float?
  flagUrl      String?
  continentId  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  continent    Continent @relation(fields: [continentId], references: [id], onDelete: Restrict)
  cities       City[]
}

model City {
  id           String        @id @default(cuid())
  name         String
  state        String?
  countryId    String
  latitude     Float
  longitude    Float
  population   Int?
  timezone     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  country      Country       @relation(fields: [countryId], references: [id], onDelete: Cascade)
  weatherCache WeatherCache?
}

model WeatherCache {
  id          String   @id @default(cuid())
  cityId      String   @unique
  temperature Float
  feelsLike   Float?
  humidity    Int?
  windSpeed   Float?
  description String?
  icon        String?
  provider    String
  fetchedAt   DateTime @default(now())
  city        City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
}
